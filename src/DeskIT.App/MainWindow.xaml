<Window x:Class="DeskIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskIT.App"
        mc:Ignorable="d"
        Title="DeskIT" Height="360" Width="640" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="DeskIT" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Windows 桌面 IT 运维工具（U 盘便携版）"
                       FontSize="13" Foreground="Gray" Margin="0,4,0,0" />
            <TextBlock Text="工程骨架已就绪"
                       FontSize="20" FontWeight="SemiBold" Margin="0,28,0,0" />
            <TextBlock x:Name="PermissionHintText"
                       FontSize="14" Foreground="#444" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock Text="本阶段仅验证工程结构与构建链路，尚未实现任何诊断或修复功能。"
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" Margin="0,24,0,0" />
        </StackPanel>
    </Grid>
</Window>