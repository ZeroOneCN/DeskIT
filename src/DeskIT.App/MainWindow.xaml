<Window x:Class="DeskIT.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeskIT.App"
        mc:Ignorable="d"
        Title="DeskIT 便携运维工具" Height="760" Width="1120"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:SelfCheckOutcomeToBrushConverter x:Key="OutcomeBrush" />
        <local:SelfCheckOutcomeToTextConverter x:Key="OutcomeText" />
        <local:CollectionGroupStatusToBrushConverter x:Key="GroupStatusBrush" />
        <local:DiagnosisConclusionToBrushConverter x:Key="ConclusionBrush" />
        <local:RiskLevelToBrushConverter x:Key="RiskBrush" />
        <local:ActionOutcomeToBrushConverter x:Key="ActionOutcomeBrush" />
        <local:PackageIntegrityToBrushConverter x:Key="IntegrityBrush" />
        <local:PackageMatchToBrushConverter x:Key="PackageMatchBrush" />
        <local:InstallerOutcomeToBrushConverter x:Key="InstallerOutcomeBrush" />
        <local:AccountRowToBrushConverter x:Key="AccountRowBrush" />
        <local:LedgerConclusionToBrushConverter x:Key="LedgerConclusionBrush" />
        <local:MediaStateToBrushConverter x:Key="MediaStateBrush" />
        <local:MediaStateToTextConverter x:Key="MediaStateText" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinWidth" Value="120" />
        </Style>

        <Style x:Key="FieldName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：标题与常驻状态 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="DeskIT" FontSize="24" FontWeight="Bold" Foreground="#111827" />
            <TextBlock Text="Windows 桌面 IT 运维工具（U 盘便携版）· 离线运行，数据全部写入 U 盘"
                       FontSize="12" Foreground="#6B7280" Margin="0,2,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Background="#EEF2FF" CornerRadius="10" Padding="10,4">
                    <TextBlock x:Name="PrivilegePill" FontSize="12" Foreground="#1D4ED8" Text="权限：检测中…" />
                </Border>
                <Border Background="#F3F4F6" CornerRadius="10" Padding="10,4" Margin="8,0,0,0">
                    <TextBlock x:Name="AdvancedPill" FontSize="12" Foreground="#374151" Text="高级模式：关闭" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- 受限启动 / 阻断原因横幅 -->
        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed"
                Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <TextBlock x:Name="BannerText" Foreground="#B91C1C" TextWrapping="Wrap" />
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="2" Margin="0,14,0,0" Padding="0,10,0,0"
                    SelectionChanged="OnMainTabChanged">
            <!-- ============ M1 便携启动 ============ -->
            <TabItem Header="便携启动（M1）">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="启动自检结果" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="SelfCheckList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="#6B7280" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,2,10,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="10" Padding="9,3"
                                                            Background="{Binding Outcome, Converter={StaticResource OutcomeBrush}}">
                                                        <TextBlock FontSize="11" Foreground="White"
                                                                   Text="{Binding Outcome, Converter={StaticResource OutcomeText}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="当前权限与提权" />
                                <TextBlock x:Name="PrivilegeHint" Foreground="#374151" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,10" />
                                <Button x:Name="ElevateButton" Content="以管理员身份重新启动"
                                        Height="34" Click="OnElevateClick" />
                                <Button x:Name="ReadOnlyButton" Content="继续只读诊断模式"
                                        Height="34" Margin="0,8,0,0" Click="OnReadOnlyClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="提权走系统标准 UAC 流程，不尝试绕过；取消 UAC 后回到只读诊断模式，不报错、不重试。" />

                                <Separator Margin="0,12,0,10" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="高级模式（介质级记住）" />
                                <TextBlock x:Name="AdvancedHint" Foreground="#374151" FontSize="12"
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="AdvancedButton" Content="开启高级模式"
                                        Height="32" Click="OnToggleAdvancedClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                           Text="高级模式用于启用受控自定义命令（M9）；需管理员模式 + 主密码验证 + 二次确认，可随时关闭（关闭不需密码）。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="本次可做什么（能力摘要）" />
                                <ItemsControl x:Name="CapabilityList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#374151"
                                                       TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="RestrictionTitle" Foreground="#B45309" FontWeight="SemiBold"
                                           FontSize="12" Margin="0,10,0,4" Visibility="Collapsed" Text="受限原因" />
                                <ItemsControl x:Name="RestrictionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#B45309"
                                                       TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============ M2 设备识别与信息采集 ============ -->
            <TabItem Header="设备信息采集（M2）">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 触发与采集范围 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="采集触发与范围（只读采集，不向目标机磁盘写入任何产物）" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CollectBasicButton" Style="{StaticResource PrimaryButton}"
                                        Content="开始基础采集（≤60 秒）" Click="OnCollectBasicClick" />
                                <Button x:Name="CollectFullButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Content="开始完整采集（含软件清单）" Click="OnCollectFullClick" />
                                <Button x:Name="CancelCollectButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                        Content="中止采集" IsEnabled="False" Click="OnCancelCollectClick" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="采集范围（取消勾选即单项关闭）：" FontSize="12"
                                           Foreground="#6B7280" VerticalAlignment="Center" />
                                <CheckBox x:Name="IncludeAccountCheck" Content="账号与环境" IsChecked="True"
                                          Margin="10,0,0,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="IncludeSoftwareCheck" Content="已装软件" IsChecked="True"
                                          Margin="10,0,0,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="IncludeSecurityCheck" Content="安全与更新" IsChecked="True"
                                          Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="系统、硬件、存储、网络为必采项。" FontSize="11"
                                           Foreground="#9CA3AF" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ProgressBar x:Name="CollectProgressBar" Height="6" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="CollectionProgressText" FontSize="12" Foreground="#6B7280"
                                       TextWrapping="Wrap" Text="尚未采集。基础采集默认 ≤60 秒，单项超时不阻塞其他项。" />
                        </StackPanel>
                    </Border>

                    <!-- 机器标识与档案 -->
                    <Border x:Name="MachineCard" Grid.Row="1" Style="{StaticResource CardBorder}"
                            Margin="0,12,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="目标机档案" />
                            <TextBlock x:Name="MachineIdentityText" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#111827" TextWrapping="Wrap" />
                            <TextBlock x:Name="MachineProfileText" FontSize="12" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock x:Name="MachineSnapshotText" FontSize="12" Foreground="#6B7280"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 分组摘要卡片 -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="采集结果（按分组）" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CollectionGroupList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Margin="0,0,0,6" IsExpanded="True"
                                                      BorderBrush="#E5E7EB" BorderThickness="1" Padding="8">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{Binding Status, Converter={StaticResource GroupStatusBrush}}"
                                                                CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="White" />
                                                        </Border>
                                                        <TextBlock Text="{Binding ElapsedText}" FontSize="11"
                                                                   Foreground="#9CA3AF" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="6,8,0,4">
                                                    <ItemsControl ItemsSource="{Binding Fields}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Style="{StaticResource FieldName}"
                                                                               Text="{Binding Name}" Margin="0,0,10,0" />
                                                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                                                               Text="{Binding Display}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{Binding Details}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                                           Foreground="#374151" TextWrapping="Wrap" Margin="0,1" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ M3 问题诊断 ============ -->
            <TabItem Header="问题诊断（M3）">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 诊断范围与触发 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Text="诊断场景与触发（全部为只读检查，不向目标机磁盘写入任何产物）" />
                            <WrapPanel>
                                <CheckBox x:Name="DiagSceneSlownessCheck" Content="卡慢" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagSceneNetworkCheck" Content="网络" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagScenePrintingCheck" Content="打印与共享" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagSceneDiskCheck" Content="磁盘与存储" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagSceneStartupCheck" Content="启动与系统" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagSceneSoftwareCheck" Content="软件" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox x:Name="DiagSceneAccountCheck" Content="账号与权限" IsChecked="True"
                                          Margin="0,0,16,0" VerticalAlignment="Center" />
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="DiagnoseSceneButton" Style="{StaticResource PrimaryButton}"
                                        Content="诊断勾选场景" Click="OnDiagnoseSceneClick" />
                                <Button x:Name="DiagnoseAllButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                        Content="全场景诊断" Click="OnDiagnoseAllClick" />
                                <Button x:Name="CancelDiagnoseButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                        Content="中止诊断" IsEnabled="False" Click="OnCancelDiagnoseClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="只读模式下，需管理员的诊断项标记“未执行（需要管理员权限）”，不计入异常。" />
                            </StackPanel>
                            <ProgressBar x:Name="DiagnoseProgressBar" Height="6" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="DiagnosisSessionText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#111827" TextWrapping="Wrap" Text="尚未诊断。" />
                            <TextBlock x:Name="DiagnosisProgressText" FontSize="12" Foreground="#6B7280"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="诊断项可在列表中出现异常时持续刷新；异常与提示项始终置顶显示。" />
                        </StackPanel>
                    </Border>

                    <!-- 结论列表与详情 -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="诊断结论（异常置顶）" />
                                <ListBox x:Name="DiagnosisFindingList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="10"
                                                        Padding="9,3" Margin="0,0,10,0"
                                                        Background="{Binding Conclusion, Converter={StaticResource ConclusionBrush}}">
                                                    <TextBlock FontSize="11" Foreground="White" Text="{Binding ConclusionText}" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                               FontSize="13" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Reason}" Foreground="#6B7280" FontSize="12"
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                                DataContext="{Binding SelectedItem, ElementName=DiagnosisFindingList}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="结论详情" />
                                    <TextBlock Text="请在上方列表中选择一项诊断结论，查看依据与建议。"
                                               Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#111827" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border CornerRadius="10" Padding="9,3"
                                                    Background="{Binding Conclusion, Converter={StaticResource ConclusionBrush}}">
                                                <TextBlock FontSize="11" Foreground="White" Text="{Binding ConclusionText}" />
                                            </Border>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#6B7280"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ElapsedText}" FontSize="11" Foreground="#9CA3AF"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="#374151"
                                                   TextWrapping="Wrap" Margin="0,10,0,0" />

                                        <TextBlock Text="原始依据" Style="{StaticResource CardTitle}" Margin="0,12,0,6" />
                                        <ItemsControl ItemsSource="{Binding Evidence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldName}"
                                                                   Text="{Binding Label}" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                                                   Text="{Binding Display}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="建议动作（M4 落地，需显式勾选才执行）"
                                                   Style="{StaticResource CardTitle}" Margin="0,12,0,6" />
                                        <TextBlock Text="{Binding SuggestedActionsText}" FontSize="12"
                                                   Foreground="#374151" TextWrapping="Wrap" />

                                        <TextBlock Text="该项需要管理员权限，当前只读模式未执行；以管理员身份重新启动后可执行。"
                                                   FontSize="12" Foreground="#B45309" TextWrapping="Wrap" Margin="0,10,0,0"
                                                   Visibility="{Binding ShowAdminHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ M4 修复动作库 ============ -->
            <TabItem Header="修复动作（M4）">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 动作搜索与执行触发 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Text="修复动作库（勾选后执行；排序按风险升序，需重启的排最后）" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="搜索：" FontSize="12" Foreground="#6B7280"
                                           VerticalAlignment="Center" />
                                <TextBox x:Name="ActionSearchBox" Width="220" Height="30" Margin="6,0,0,0"
                                         VerticalContentAlignment="Center"
                                         TextChanged="OnActionSearchChanged" />
                                <Button x:Name="RunActionsButton" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"
                                        Content="执行勾选动作" IsEnabled="False" Click="OnRunActionsClick" />
                                <Button x:Name="CancelActionsButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                        Content="中止后续动作" IsEnabled="False" Click="OnCancelActionsClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="按“名称 / 影响 / 标识 / 场景”搜索；只读诊断模式下动作库全部禁用。" />
                            </StackPanel>
                            <ProgressBar x:Name="ActionProgressBar" Height="6" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="ActionLibraryText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#111827" TextWrapping="Wrap" Text="正在加载动作库…" />
                            <TextBlock x:Name="ActionProgressText" FontSize="12" Foreground="#6B7280"
                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                       Text="只读动作无需确认；中风险为汇总确认；高风险逐项确认；不可逆需输入确认词后才执行。" />
                            <TextBlock x:Name="ActionProblemText" FontSize="12" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 动作清单与执行结果 -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,14,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="可选动作（按风险升序，需重启排最后）" />
                                <ListBox x:Name="ActionList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,9">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,1,10,0"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanRun}" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                    Background="{Binding Risk, Converter={StaticResource RiskBrush}}">
                                                                <TextBlock FontSize="11" Foreground="White" Text="{Binding RiskText}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                       TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                            <Border Background="#EEF2FF" CornerRadius="10" Padding="8,2"
                                                                    Margin="10,0,0,0" VerticalAlignment="Center"
                                                                    Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock FontSize="11" Foreground="#1D4ED8" Text="需重启生效" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding SceneName}" Foreground="#9CA3AF" FontSize="11"
                                                                   Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="#6B7280" FontSize="12"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="{Binding ConfirmationText}" FontSize="11"
                                                                       Foreground="#6B7280" />
                                                            <TextBlock Text="{Binding RollbackText}" FontSize="11"
                                                                       Foreground="#6B7280" Margin="12,0,0,0" />
                                                            <TextBlock Text="{Binding TimeoutText}" FontSize="11"
                                                                       Foreground="#9CA3AF" Margin="12,0,0,0" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,6,0,0"
                                                                      Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="0,2">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="180" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldName}"
                                                                                   Text="{Binding Description}" VerticalAlignment="Center"
                                                                                   Margin="0,0,10,0" />
                                                                        <TextBox Grid.Column="1" Height="26" MaxWidth="320"
                                                                                 HorizontalAlignment="Left" MinWidth="200"
                                                                                 VerticalContentAlignment="Center"
                                                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding DisabledReason}" Foreground="#B45309"
                                                                   FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                                   Visibility="{Binding ShowDisabledReason, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="执行结果" />
                                <TextBlock DockPanel.Dock="Top" FontSize="12" Foreground="#9CA3AF"
                                           TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="尚未执行任何动作。执行记录与回滚信息会写入 U 盘备份区（data\backup\actions）。" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ActionResultList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                    Background="{Binding Outcome, Converter={StaticResource ActionOutcomeBrush}}">
                                                                <TextBlock FontSize="11" Foreground="White" Text="{Binding OutcomeText}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="13"
                                                                       TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DetailText}" Foreground="#6B7280" FontSize="11"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding ErrorText}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding OutputText}" FontFamily="Consolas" FontSize="11"
                                                                   Foreground="#374151" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ M5 软件安装与卸载 ============ -->
            <TabItem Header="软件安装卸载（M5）">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部：包加载与已装清单 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Text="U 盘软件包（来源不可验证的包默认禁止执行；安装 / 卸载仅在管理员模式下可用）" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ReloadPackagesButton" Style="{StaticResource PrimaryButton}"
                                        Content="重新加载软件包" Click="OnReloadPackagesClick" />
                                <Button x:Name="RefreshInstalledButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                        Content="刷新已装软件" Click="OnRefreshInstalledClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="包描述位于 U 盘 packages\*.json；重新加载会重新校验安装程序的 SHA-256。" />
                            </StackPanel>
                            <ProgressBar x:Name="PackageProgressBar" Height="6" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="PackageStatusText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#111827" TextWrapping="Wrap" Text="正在加载软件包…" />
                            <TextBlock x:Name="PackageProblemText" FontSize="12" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 三列：软件包 / 已装软件 / 操作与结果 -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="420" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="软件包（U 盘）" />
                                <ListBox x:Name="PackageList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnPackageSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                Background="{Binding Integrity, Converter={StaticResource IntegrityBrush}}">
                                                            <TextBlock FontSize="11" Foreground="White"
                                                                       Text="{Binding IntegrityText}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                                   FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PublisherText}" FontSize="11"
                                                               Foreground="#6B7280" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                               Foreground="#9CA3AF" Margin="0,1,0,0" />
                                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                                            Margin="0,4,0,0"
                                                            Background="{Binding Match, Converter={StaticResource PackageMatchBrush}}">
                                                        <TextBlock FontSize="11" Foreground="White"
                                                                   Text="{Binding MatchDetailText}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding IntegrityRemedy}" FontSize="11"
                                                               Foreground="#B45309" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Visibility="{Binding HasRemedy, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="目标机已装软件（只读）" />
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="搜索：" FontSize="12" Foreground="#6B7280"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="InstalledSearchBox" Width="200" Height="28" Margin="6,0,0,0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnInstalledSearchChanged" />
                                </StackPanel>
                                <ListBox x:Name="InstalledList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,7">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                               FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Publisher}" FontSize="11"
                                                               Foreground="#6B7280" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding LocationText}" FontSize="11"
                                                               Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="对选中包执行操作" />
                                    <TextBlock x:Name="PackageOperationTargetText" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#111827" TextWrapping="Wrap" Text="未选择软件包。" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <RadioButton x:Name="PackageInstallRadio" GroupName="PackageOperation"
                                                     Content="安装" IsChecked="True" VerticalAlignment="Center"
                                                     Checked="OnPackageOperationChanged" />
                                        <RadioButton x:Name="PackageUpgradeRadio" GroupName="PackageOperation"
                                                     Content="升级（覆盖安装）" Margin="14,0,0,0" VerticalAlignment="Center"
                                                     Checked="OnPackageOperationChanged" />
                                        <RadioButton x:Name="PackageUninstallRadio" GroupName="PackageOperation"
                                                     Content="卸载" Margin="14,0,0,0" VerticalAlignment="Center"
                                                     Checked="OnPackageOperationChanged" />
                                    </StackPanel>
                                    <CheckBox x:Name="PackageForceReinstallCheck" Margin="0,8,0,0"
                                              Content="强制重装（已装同版本时覆盖安装，需二次确认）" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="RunPackageButton" Style="{StaticResource PrimaryButton}"
                                                Content="执行操作" IsEnabled="False" Click="OnRunPackageClick" />
                                        <Button x:Name="CancelPackageButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                                Content="中止" IsEnabled="False" Click="OnCancelPackageClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="PackagePreflightText" FontSize="12" Foreground="#6B7280"
                                               TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="请选择左侧软件包以查看执行前检查结果。" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                    <ItemsControl x:Name="PackageResultList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="0,9">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                    Background="{Binding Outcome, Converter={StaticResource InstallerOutcomeBrush}}">
                                                                <TextBlock FontSize="11" Foreground="White"
                                                                           Text="{Binding OutcomeText}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                                       FontSize="13" TextWrapping="Wrap" Margin="10,0,0,0"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12"
                                                                   Foreground="#374151" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                                   Foreground="#6B7280" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding AfterText}" FontSize="12"
                                                                   Foreground="#B45309" TextWrapping="Wrap" Margin="0,3,0,0"
                                                                   Visibility="{Binding HasAfterText, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding ErrorText}" FontFamily="Consolas"
                                                                   FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                        <TextBlock Text="{Binding OutputText}" FontFamily="Consolas"
                                                                   FontSize="11" Foreground="#374151" TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"
                                                                   Visibility="{Binding HasOutput, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ M6 账号与权限辅助 ============ -->
            <TabItem Header="账号与权限（M6）">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}"
                                       Text="账号与权限只读查询（不产生任何系统变更；变更类操作请在“修复动作（M4）”中选择并二次确认）" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="QueryAccountsButton" Style="{StaticResource PrimaryButton}"
                                        Content="查询账号与权限" Click="OnQueryAccountsClick" />
                                <Button x:Name="CancelAccountQueryButton" Height="34" Padding="14,0" Margin="8,0,0,0"
                                        Content="中止查询" IsEnabled="False" Click="OnCancelAccountQueryClick" />
                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="解锁 / 启用 / 停用 / 重命名 / 清理缓存的共享凭据等变更操作由 M4 动作库执行，均需二次确认。" />
                            </StackPanel>
                            <ProgressBar x:Name="AccountProgressBar" Height="6" Margin="0,12,0,6"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock x:Name="AccountSummaryText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#111827" TextWrapping="Wrap" Text="尚未查询。" />
                            <TextBlock x:Name="AccountQueryText" FontSize="11" Foreground="#6B7280"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                            <TextBlock x:Name="AccountAttentionText" FontSize="12" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="AccountProblemsText" FontSize="12" Foreground="#B45309"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="本地账号（只读）" />
                                <ListBox x:Name="AccountList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                Background="{Binding Converter={StaticResource AccountRowBrush}}">
                                                            <TextBlock FontSize="11" Foreground="White"
                                                                       Text="{Binding StatusText}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding FullNameText}" FontSize="11"
                                                                   Foreground="#6B7280" Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding HasFullName, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SourceText}" FontSize="11"
                                                               Foreground="#6B7280" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding LastLogonText}" FontSize="11"
                                                               Foreground="#9CA3AF" Margin="0,1,0,0" />
                                                    <TextBlock Text="{Binding PasswordText}" FontSize="11"
                                                               Foreground="#9CA3AF" Margin="0,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="本地管理员组成员（只读）" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="AdministratorList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#374151"
                                                           TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                           Text="UAC / 域 / 策略 / 时间与凭据残留（只读）" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl x:Name="AccountFactList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldName}"
                                                                   Text="{Binding Name}" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                                                   Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="共享凭据残留（凭据管理器）" Style="{StaticResource CardTitle}"
                                                   Margin="0,12,0,4"
                                                   Visibility="{Binding HasItems, ElementName=AccountCredentialList, Converter={StaticResource BoolToVisibility}}" />
                                        <ItemsControl x:Name="AccountCredentialList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                               Foreground="#374151" TextWrapping="Wrap" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="AccountCredentialEmptyText" FontSize="12" Foreground="#6B7280"
                                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="未发现缓存的共享凭据残留。" />
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============ M7 记录与多机台账 ============ -->
            <TabItem Header="记录与台账（M7）">
                <TabControl x:Name="LedgerTabs" Margin="0,4,0,0">
                    <!-- 本次会话 -->
                    <TabItem Header="本次会话">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}"
                                               Text="本次会话（采集 / 诊断 / 动作自动建立；结束后确认结论与问题类别）" />
                                    <TextBlock x:Name="LedgerSessionInfoText" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#111827" TextWrapping="Wrap"
                                               Text="尚未建立会话：请先在“设备信息采集（M2）”“问题诊断（M3）”中开始一次处理。" />
                                    <TextBlock x:Name="LedgerHistoryNoticeText" FontSize="12" Foreground="#1D4ED8"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="ViewLastHandledButton" Height="30" Padding="12,0"
                                                Content="查看上次处理" IsEnabled="False" Click="OnViewLastHandledClick" />
                                        <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                                   Text="按机器标识归并：同一机器第二次处理时，这里会提示历史处理次数与最近结论。" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <StackPanel x:Name="LedgerFormPanel" IsEnabled="False">
                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}"
                                                       Text="结论（必填；选择“未解决”时必须选择原因）" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="LedgerConclusionResolvedRadio" GroupName="LedgerConclusion"
                                                             Content="已解决" IsChecked="True" Checked="OnLedgerConclusionChanged"
                                                             VerticalAlignment="Center" />
                                                <RadioButton x:Name="LedgerConclusionRestartRadio" GroupName="LedgerConclusion"
                                                             Content="待重启生效" Margin="16,0,0,0" Checked="OnLedgerConclusionChanged"
                                                             VerticalAlignment="Center" />
                                                <RadioButton x:Name="LedgerConclusionUnresolvedRadio" GroupName="LedgerConclusion"
                                                             Content="未解决" Margin="16,0,0,0" Checked="OnLedgerConclusionChanged"
                                                             VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel x:Name="LedgerUnresolvedPanel" Orientation="Horizontal"
                                                        Margin="0,10,0,0" Visibility="Collapsed">
                                                <TextBlock Text="未解决原因：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" />
                                                <ComboBox x:Name="LedgerUnresolvedReasonCombo" Width="240" Height="28"
                                                          Margin="6,0,0,0" DisplayMemberPath="Text" />
                                                <TextBlock Text="说明：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                                                <TextBox x:Name="LedgerUnresolvedNoteBox" Width="300" Height="28"
                                                         Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}"
                                                       Text="问题类别与标签（类别必填，一条记录一个主类别）" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="问题类别：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" />
                                                <ComboBox x:Name="LedgerCategoryCombo" Width="200" Height="28"
                                                          Margin="6,0,0,0" DisplayMemberPath="Text"
                                                          SelectionChanged="OnLedgerCategoryChanged" />
                                                <TextBlock Text="自定义标签：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                                                <TextBox x:Name="LedgerTagsBox" Width="260" Height="28"
                                                         Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="LedgerReuseHintText" FontSize="12" Foreground="#1D4ED8"
                                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="员工现象描述（选填，≤ 500 字）" />
                                            <TextBox x:Name="LedgerSymptomBox" Height="70" AcceptsReturn="True"
                                                     TextWrapping="Wrap" MaxLength="500" VerticalScrollBarVisibility="Auto"
                                                     TextChanged="OnSymptomChanged" />
                                            <TextBlock x:Name="LedgerSymptomCountText" FontSize="11" Foreground="#9CA3AF"
                                                       Margin="0,4,0,0" Text="0 / 500" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}"
                                                       Text="处理人（工号与姓名均必填；默认取介质当前登记，会话中修改仅影响本次记录，需二次确认）" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="工号：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" />
                                                <TextBox x:Name="LedgerOperatorIdBox" Width="160" Height="28"
                                                         Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                                <TextBlock Text="姓名：" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                                                <TextBox x:Name="LedgerOperatorNameBox" Width="160" Height="28"
                                                         Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                                <Button x:Name="SaveOperatorButton" Height="28" Padding="10,0"
                                                        Margin="16,0,0,0" Content="登记为介质处理人"
                                                        Click="OnSaveOperatorClick" />
                                            </StackPanel>
                                            <TextBlock x:Name="LedgerOperatorHintText" FontSize="11" Foreground="#9CA3AF"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Text="介质尚未登记处理人时，请在此填写并登记。" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="FinishLedgerButton" Style="{StaticResource PrimaryButton}"
                                                        Content="完成会话并产出报告" IsEnabled="False"
                                                        Click="OnFinishSessionClick" />
                                                <TextBlock Foreground="#9CA3AF" FontSize="11" Margin="12,0,0,0"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Text="写入台账（不可修改）+ 静默产出脱敏报告（HTML + Markdown）到 U 盘 reports 目录；介质不可写时会阻止结束。" />
                                            </StackPanel>
                                            <TextBlock x:Name="LedgerFinishStatusText" FontSize="12" Foreground="#6B7280"
                                                       TextWrapping="Wrap" Margin="0,8,0,0"
                                                       Text="完成一次处理并确认结论后，记录会写入台账。" />
                                            <TextBlock x:Name="LedgerReportResultText" FontSize="12" Foreground="#B45309"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- 目标机档案 -->
                    <TabItem Header="目标机档案">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}"
                                               Text="目标机档案（本机历史记录，按处理时间倒序；可展开查看当时的诊断依据）" />
                                    <TextBlock x:Name="MachineHistoryNoticeText" FontSize="12" Foreground="#1D4ED8"
                                               TextWrapping="Wrap" Text="尚未加载台账。" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                <ListBox x:Name="MachineRecordList" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,9">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                Background="{Binding Conclusion, Converter={StaticResource LedgerConclusionBrush}}">
                                                            <TextBlock FontSize="11" Foreground="White" Text="{Binding ConclusionText}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="13"
                                                                   Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#6B7280"
                                                               Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding OperatorText}" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,1,0,0" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding TagText}" FontSize="11" Foreground="#9CA3AF"
                                                               Margin="0,1,0,0" TextWrapping="Wrap"
                                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Text="{Binding ActionSummaryText}" FontSize="12"
                                                               Foreground="#374151" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding ConflictText}" FontSize="11" Foreground="#B91C1C"
                                                               TextWrapping="Wrap" Margin="0,3,0,0"
                                                               Visibility="{Binding IsConflict, Converter={StaticResource BoolToVisibility}}" />
                                                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                    <Border CornerRadius="10" Padding="7,1" VerticalAlignment="Center"
                                                                            Background="{Binding Outcome, Converter={StaticResource ActionOutcomeBrush}}">
                                                                        <TextBlock FontSize="10" Foreground="White" Text="{Binding OutcomeText}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding ActionText}" FontSize="11"
                                                                               Foreground="#374151" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding DurationText}" FontSize="11"
                                                                               Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Expander Header="查看当时的诊断依据" Margin="0,4,0,0"
                                                              Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                                   Foreground="#6B7280" TextWrapping="Wrap" />
                                                    </Expander>
                                                    <TextBlock Text="{Binding ReportName}" FontSize="11"
                                                               Foreground="#9CA3AF" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- 台账总览 -->
                    <TabItem Header="台账总览">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}"
                                               Text="筛选与统计（离线本地，不引入图表依赖）" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="问题类别：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="LedgerFilterCategoryCombo" Width="150" Height="28"
                                                  Margin="6,0,0,0" DisplayMemberPath="Text" />
                                        <TextBlock Text="处理人工号：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <TextBox x:Name="LedgerFilterOperatorBox" Width="140" Height="28"
                                                 Margin="6,0,0,0" VerticalContentAlignment="Center" />
                                        <TextBlock Text="起始：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <DatePicker x:Name="LedgerFilterFromPicker" Width="130" Height="28" Margin="6,0,0,0" />
                                        <TextBlock Text="结束：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <DatePicker x:Name="LedgerFilterToPicker" Width="130" Height="28" Margin="6,0,0,0" />
                                        <Button x:Name="ApplyLedgerFilterButton" Height="28" Padding="12,0"
                                                Margin="16,0,0,0" Content="应用筛选" Click="OnApplyLedgerFilterClick" />
                                        <Button x:Name="ResetLedgerFilterButton" Height="28" Padding="12,0"
                                                Margin="8,0,0,0" Content="重置" Click="OnResetLedgerFilterClick" />
                                        <Button x:Name="ReloadLedgerButton" Height="28" Padding="12,0"
                                                Margin="8,0,0,0" Content="重新加载台账" Click="OnReloadLedgerClick" />
                                    </StackPanel>
                                    <TextBlock x:Name="LedgerStatText" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#111827" TextWrapping="Wrap" Margin="0,10,0,0"
                                               Text="台账为空。" />
                                    <TextBlock x:Name="LedgerStatCategoryText" FontSize="12" Foreground="#6B7280"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock x:Name="LedgerStatOperatorText" FontSize="12" Foreground="#6B7280"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock x:Name="LedgerStatUnresolvedText" FontSize="12" Foreground="#B45309"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock x:Name="LedgerConflictText" FontSize="12" Foreground="#B91C1C"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}"
                                               Text="导出（默认脱敏；范围与格式自选，默认保存到 reports 目录）" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="范围：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                        <ComboBox x:Name="LedgerExportScopeCombo" Width="180" Height="28"
                                                  Margin="6,0,0,0" DisplayMemberPath="Text" />
                                        <TextBlock Text="格式：" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" Margin="16,0,0,0" />
                                        <ComboBox x:Name="LedgerExportFormatCombo" Width="120" Height="28"
                                                  Margin="6,0,0,0" DisplayMemberPath="Text" />
                                        <Button x:Name="ExportLedgerButton" Height="28" Padding="12,0"
                                                Margin="16,0,0,0" Content="导出…" Click="OnExportLedgerClick" />
                                        <TextBlock x:Name="LedgerExportStatusText" FontSize="12" Foreground="#6B7280"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="420" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                                   Text="台账记录与机器列表（本 U 盘处理过的所有机器）" />
                                        <ListBox x:Name="LedgerMachineList" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="OnLedgerMachineSelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                                                        Background="{Binding LastConclusion, Converter={StaticResource LedgerConclusionBrush}}">
                                                                    <TextBlock FontSize="11" Foreground="White"
                                                                               Text="{Binding LastConclusionText}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold"
                                                                           FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SummaryText}" FontSize="11"
                                                                       Foreground="#6B7280" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource CardBorder}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                                       Text="选中机器的记录（按处理时间倒序）" />
                                            <ListBox x:Name="LedgerRecordList" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,7">
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border CornerRadius="10" Padding="7,2" VerticalAlignment="Center"
                                                                            Background="{Binding Conclusion, Converter={StaticResource LedgerConclusionBrush}}">
                                                                        <TextBlock FontSize="10" Foreground="White"
                                                                                   Text="{Binding ConclusionText}" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding CategoryText}" FontWeight="SemiBold"
                                                                               FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                                           Foreground="#9CA3AF" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding OperatorText}" FontSize="11"
                                                                           Foreground="#9CA3AF" Margin="0,1,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>

                                    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}"
                                                       Text="报告查看器（reports 目录，可离线打开）" />
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                                <Button x:Name="OpenReportButton" Height="28" Padding="12,0"
                                                        Content="用浏览器打开" Click="OnOpenReportClick" />
                                                <Button x:Name="OpenReportFolderButton" Height="28" Padding="12,0"
                                                        Margin="8,0,0,0" Content="打开所在文件夹" Click="OnOpenReportFolderClick" />
                                                <Button x:Name="RefreshReportsButton" Height="28" Padding="12,0"
                                                        Margin="8,0,0,0" Content="刷新列表" Click="OnRefreshReportsClick" />
                                            </StackPanel>
                                            <ListBox x:Name="LedgerReportList" Height="150" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="2,6">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                                                           ToolTip="{Binding FullPath}" />
                                                                <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                                           Foreground="#9CA3AF" />
                                                                <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                                           Foreground="#9CA3AF" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ============ M8 介质与设置 ============ -->
            <TabItem Header="介质与设置（M8）">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="介质状态" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <StackPanel Width="260" Margin="0,0,16,10">
                                        <TextBlock Text="介质标识" Style="{StaticResource FieldName}" />
                                        <TextBlock x:Name="SettingsMediaIdText" Style="{StaticResource FieldValue}" Text="（读取中…）" />
                                    </StackPanel>
                                    <StackPanel Width="300" Margin="0,0,16,10">
                                        <TextBlock Text="数据目录" Style="{StaticResource FieldName}" />
                                        <TextBlock x:Name="SettingsDataDirectoryText" Style="{StaticResource FieldValue}" Text="（读取中…）" />
                                    </StackPanel>
                                    <StackPanel Width="260" Margin="0,0,16,10">
                                        <TextBlock Text="介质迁移" Style="{StaticResource FieldName}" />
                                        <TextBlock x:Name="SettingsMigrationText" Style="{StaticResource FieldValue}" Text="（读取中…）" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="介质金库：主密码经 PBKDF2-HMAC-SHA256 派生密钥，数据以 AES-256-GCM 认证加密；不绑定机器，可跨机使用。"
                                           Style="{StaticResource FieldName}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="介质设置" Style="{StaticResource CardTitle}" />
                                <WrapPanel>
                                    <StackPanel Width="220" Margin="0,0,16,10">
                                        <TextBlock Text="无操作自动锁定（分钟，0 表示不自动锁定）" Style="{StaticResource FieldName}" />
                                        <TextBox x:Name="SettingsAutoLockBox" Height="28" />
                                    </StackPanel>
                                    <StackPanel Width="240" Margin="0,0,16,10">
                                        <TextBlock Text="界面脱敏（投屏 / 示教场景）" Style="{StaticResource FieldName}" />
                                        <CheckBox x:Name="SettingsDesensitizeCheck" Content="开启界面脱敏" Height="28" />
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="保存设置" Height="30" Padding="14,0" Click="OnSaveSettingsClick" />
                                    <Button Content="立即锁定介质" Height="30" Padding="14,0" Margin="10,0,0,0" Click="OnLockMediaClick" />
                                </StackPanel>
                                <TextBlock x:Name="SettingsMessageText" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="高级模式（需主密码 + 二次确认）" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SettingsAdvancedStateText" Style="{StaticResource FieldValue}" Text="（读取中…）" />
                                <StackPanel Width="280" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <TextBlock Text="主密码（用于验证身份，仅内存使用）" Style="{StaticResource FieldName}" />
                                    <PasswordBox x:Name="SettingsPasswordBox" Height="28" />
                                </StackPanel>
                                <Button x:Name="SettingsAdvancedButton" Content="开启高级模式" Height="30" Padding="14,0"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnToggleAdvancedFromSettingsClick" />
                                <TextBlock x:Name="SettingsAdvancedMessageText" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="处理人切换（二次确认 + 审计）" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SettingsOperatorText" Style="{StaticResource FieldValue}" Text="（读取中…）" />
                                <StackPanel Width="280" HorizontalAlignment="Left" Margin="0,8,0,0">
                                    <TextBlock Text="已登记处理人（在“记录与台账（M7）”登记新处理人）" Style="{StaticResource FieldName}" />
                                    <ComboBox x:Name="SettingsOperatorCombo" Height="28" />
                                </StackPanel>
                                <Button Content="切换为所选处理人" Height="30" Padding="14,0"
                                        HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnSwitchOperatorClick" />
                                <TextBlock x:Name="SettingsOperatorMessageText" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 页脚：常驻介质可写状态指示 + 安全移除入口 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                       Text="正在执行启动自检…" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border x:Name="MediaStatusPill" CornerRadius="10" Padding="10,4"
                        Background="{Binding Path=Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MediaStateBrush}}">
                    <TextBlock x:Name="MediaStatusText" FontSize="12" Foreground="White"
                               Text="{Binding Path=Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource MediaStateText}}" />
                </Border>
                <Button x:Name="SafeEjectButton" Content="安全移除介质" Height="28" Padding="12,0" Margin="10,0,0,0"
                        Click="OnSafeEjectClick" />
            </StackPanel>
        </Grid>

        <!-- 介质门禁：未初始化 / 未解锁时覆盖整个窗口 -->
        <Grid x:Name="MediaGate" Grid.Row="0" Grid.RowSpan="4" Background="#E6F3F4F6" Visibility="Collapsed">
            <Border Style="{StaticResource CardBorder}" Width="580" Padding="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="介质安全（M8）" FontSize="18" FontWeight="Bold" Foreground="#111827" />
                    <TextBlock x:Name="MediaGateSummaryText" Style="{StaticResource FieldName}" Margin="0,6,0,14" TextWrapping="Wrap" />

                    <!-- 初始化向导 -->
                    <StackPanel x:Name="MediaInitPanel" Visibility="Collapsed">
                        <TextBlock Text="首次使用：设置主密码并登记处理人（一次性设置，随介质保存）"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#111827" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Width="240" Margin="0,0,16,0">
                                <TextBlock Text="处理人工号" Style="{StaticResource FieldName}" />
                                <TextBox x:Name="InitOperatorIdBox" Height="28" />
                            </StackPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="处理人姓名" Style="{StaticResource FieldName}" />
                                <TextBox x:Name="InitOperatorNameBox" Height="28" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Width="240" Margin="0,0,16,0">
                                <TextBlock Text="主密码（至少 8 位，不含空白）" Style="{StaticResource FieldName}" />
                                <PasswordBox x:Name="InitPasswordBox" Height="28" />
                            </StackPanel>
                            <StackPanel Width="240">
                                <TextBlock Text="再次输入主密码" Style="{StaticResource FieldName}" />
                                <PasswordBox x:Name="InitPasswordConfirmBox" Height="28" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="InitConfirmCheck" Margin="0,12,0,0"
                                  Content="我已了解：忘记主密码将无法恢复数据" />
                        <TextBlock x:Name="InitForgetWarningText" Margin="0,8,0,0" FontSize="12"
                                   Foreground="#B91C1C" TextWrapping="Wrap" />
                        <Button x:Name="InitializeMediaButton" Content="初始化介质并解锁" Height="32" Padding="16,0"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnInitializeMediaClick" />
                        <TextBlock x:Name="InitMessageText" Style="{StaticResource FieldName}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 解锁面板 -->
                    <StackPanel x:Name="MediaUnlockPanel" Visibility="Collapsed">
                        <TextBlock x:Name="UnlockMediaIdText" Style="{StaticResource FieldValue}" />
                        <TextBlock x:Name="MigrationNoticeText" Margin="0,6,0,0" FontSize="12"
                                   Foreground="#B45309" TextWrapping="Wrap" Visibility="Collapsed" />
                        <TextBlock x:Name="UnlockFailedText" Style="{StaticResource FieldName}" Margin="0,8,0,0" />
                        <StackPanel Width="300" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <TextBlock Text="主密码" Style="{StaticResource FieldName}" />
                            <PasswordBox x:Name="UnlockPasswordBox" Height="30"
                                         KeyDown="OnUnlockPasswordKeyDown" />
                        </StackPanel>
                        <TextBlock x:Name="UnlockCooldownText" FontSize="12" Foreground="#B91C1C"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                        <Button x:Name="UnlockButton" Content="解锁介质" Height="32" Padding="16,0"
                                HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnUnlockMediaClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>