<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeskIT.Core\DeskIT.Core.csproj" />
    <ProjectReference Include="..\DeskIT.Windows\DeskIT.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    自包含单文件发布配置（PRD 8.1）。
    仅在显式传入 -p:DeskITPortable=true 时生效，因此不会影响 dotnet build 的行为与输出。
    发布命令：dotnet publish src\DeskIT.App\DeskIT.App.csproj -c Release -p:DeskITPortable=true
  -->
  <PropertyGroup Condition="'$(DeskITPortable)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
